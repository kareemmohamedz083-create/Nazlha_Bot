@bot.message_handler(commands=['approve'])
def approve(message):
    if message.from_user.id != ADMIN_ID:
        return
    try:
        parts = message.text.split()
        user_id = parts[1]
        end = datetime.now() + timedelta(days=30)
        subs[user_id] = end.isoformat()
        save_data()
        bot.send_message(int(user_id), "مبروووك\nتم تفعيل اشتراكك لمدة 30 يوم\nدلوقتي تقدر تحمل براحتك، ابعت اي لينك!")
        bot.send_message(message.chat.id, "تم التفعيل")
    except:
        bot.send_message(message.chat.id, "اكتب كده: /approve 123456789")

@bot.message_handler(func=lambda m: True)
def download(message):
    url = message.text.strip()
    if not url.startswith("http"):
        bot.send_message(message.chat.id, "ابعت لينك فيديو من تيك توك او انستجرام او يوتيوب")
        return

    user_id = str(message.from_user.id)
    today = datetime.now().strftime("%Y-%m-%d")
    key = f"{user_id}_{today}"

    if not is_subscribed(user_id):
        count = usage.get(key, 0)
        if count >= 3:
            markup = types.InlineKeyboardMarkup()
            markup.add(types.InlineKeyboardButton("اشترك بـ 25 جنيه / شهر", callback_data="subscribe"))
            bot.send_message(message.chat.id, "خلصت الـ 3 تحميلات المجانية بتاعت النهاردة\nاشترك بـ 25 جنيه بس، وحمل براحتك طول الشهر.", reply_markup=markup)
            return
        usage[key] = count + 1
        save_data()

    bot.send_message(message.chat.id, "جاري التحميل...")

    try:
        ydl_opts = {'format': 'best', 'outtmpl': 'video_%(id)s.%(ext)s', 'quiet': True}
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=True)
            filename = ydl.prepare_filename(info)
        with open(filename, 'rb') as f:
            bot.send_video(message.chat.id, f, caption="تم التحميل من بوت نزلها")
        os.remove(filename)
    except Exception as e:
        bot.send_message(message.chat.id, "في مشكلة في اللينك ده، جرب لينك تاني")

