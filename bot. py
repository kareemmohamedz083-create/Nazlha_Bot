import telebot
from telebot import types
import yt_dlp
import os
import json
from datetime import datetime, timedelta

TOKEN = "9155863926:AAEbCCWbVLzvV_vzPBIgHzwrWM6-O5yOfBY"
ADMIN_ID = 7137374923
VODAFONE_NUMBER = "01098696839"

bot = telebot.TeleBot(TOKEN)

try:
    with open('subs.json', 'r') as f:
        subs = json.load(f)
except:
    subs = {}

try:
    with open('usage.json', 'r') as f:
        usage = json.load(f)
except:
    usage = {}

def save_data():
    with open('subs.json', 'w') as f:
        json.dump(subs, f)
    with open('usage.json', 'w') as f:
        json.dump(usage, f)

def is_subscribed(user_id):
    uid = str(user_id)
    if uid in subs:
        end = datetime.fromisoformat(subs[uid])
        if datetime.now() < end:
            return True
    return False

